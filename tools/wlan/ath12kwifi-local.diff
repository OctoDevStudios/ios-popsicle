+static int rddm_keyword(const u8 *p, size_t n) {
+  static const char *const k[] = { "assert", "fatal", "exception", "fail", "error", "panic", "abort", "crash", ".c", ".cpp" };
+  for (size_t i = 0; i < n; i++)
