+
+static void
+ms_state(void *ctx, QcomGlinkChannel *ch, int up)
+{
+	(void)ctx;
+	printf("PANDORA MODEM: IPCRTR %s\n", up ? "up" : "down");
+	if (up) {
+		ms_qrtr_send_hello(ch);
+	}
+}
