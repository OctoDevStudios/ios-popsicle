+		return;
+	}
+	ms_rx_shown++;
+	uint32_t w[12] = {0};
+	memcpy(w, d, MIN(len, sizeof(w)));
+	static const char *const names[12] = {"?", "DATA", "HELLO", "BYE", "NEW_SERVER", "DEL_SERVER", "DEL_CLIENT", "RESUME_TX",
+	    "EXIT", "PING", "NEW_LOOKUP", "DEL_LOOKUP"};
+	const uint32_t t = w[1];
+	if (w[0] == 1 && t == 4 && len >= 48) {
+		printf("PANDORA MODEM: QRTR NEW_SERVER service %u instance %#x node %u port %u\n", w[9], w[10], w[11], len >= 52 ? d[48] : 0);
+	} else if (w[0] == 1 && t == 10) {
+		printf("PANDORA MODEM: QRTR NEW_LOOKUP (asks for) service %u instance %#x\n", w[9], w[10]);
+	} else {
+		printf("PANDORA MODEM: QRTR v%u %s from %u:%u to %u:%u, %u bytes, words %08x %08x %08x\n", w[0], t < 12 ? names[t] : "?", w[2], w[3], w[6], w[7],
+		    w[5], w[8], w[9], w[10]);
+	}
+	if (w[0] == 1 && t == 2) {
