+/* ---- 0347: the modem's start ------------------------------------------------------------- */
+
+/*
+ * qcom_q6v5_pas.c with canoe_mpss_resource: pas 4, DTB pas 0x26, carveouts mpss 0x8aa00000 + 0xeb00000 and
+ * q6_mpss_dtb 0x99500000 + 0x80000, firmware in modemfirmware_<slot> (Android's /vendor/modem_firmware; read only),
+ * the DSM partitions (memory-region 3 and 4) assigned to the modem's VM. Boot-arg pandora_mss=1. No rmtfs here: the
+ * modem cannot reach its EFS partitions, it only asks the apps for them. This step says how far it gets alone.
+ */
+#define MS_LOW_PA    0xe0600000ull      /* System RAM of the low bank under Android, nothing of XNU's: metadata */
+#define MS_TABLE_PA  0xe0700000ull      /* the tables of the assign call */
+
+static int
+mss_assign(uint64_t pa, uint64_t size)
+{
+	static vm_offset_t tb;
+	static bool bridged;
+	struct scm_res r;
+	if (!tb && !(tb = ad_map(MS_TABLE_PA, 0x1000, VM_WIMG_IO))) {
+		return ENOMEM;
+	}
+	for (unsigned attempt = 0; attempt < 2; attempt++) {
+		volatile uint64_t *q = (volatile uint64_t *)tb;
+		for (unsigned i = 0; i < 512; i++) {
+			q[i] = 0;
 		}
+		*(volatile uint32_t *)tb = 3;                          /* source: HLOS */
+		q[64 / 8] = pa;
+		q[64 / 8 + 1] = size;
+		*(volatile uint32_t *)(tb + 128) = 15;                 /* destination: MSS_MSA */
+		*(volatile uint32_t *)(tb + 132) = 6;                  /* read and write */
+		q[192 / 8] = 4;                                        /* args[3..6], beyond the registers */
+		q[192 / 8 + 1] = MS_TABLE_PA + 128;
+		q[192 / 8 + 2] = 24;
+		q[192 / 8 + 3] = 0;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		scm_smc(SCM_FN(0xc, 0x16), SCM_ARGS(7) | (1u << 4) | (1u << 8) | (1u << 12), MS_TABLE_PA + 64, 16,
+		    MS_TABLE_PA, MS_TABLE_PA + 192, &r);
+		printf("PANDORA MODEM: assign %#llx+%#llx -> a0 %#llx a1 %#llx%s\n", pa, size, r.a0, r.a1,
+		    bridged ? " (bridged)" : "");
+		if (!r.a0 && !r.a1) {
+			return 0;
+		}
+		if (bridged) {
+			break;
+		}
+		/* qcom_tzmem.c: the buffers of such a call live in an SHM bridge. */
+		scm_smc(SCM_FN(0xc, 0x1e), SCM_ARGS(4), MS_TABLE_PA | 6, MS_TABLE_PA | 6, 0x1000 | (1u << 9), 3, &r);
+		printf("PANDORA MODEM: bridge -> a0 %#llx a1 %#llx\n", r.a0, r.a1);
+		bridged = true;
 	}
+	return EIO;
 }
 
+static void
+mss_start(void)
+{
+	struct edge *e = &ed_modem;
+	struct scm_res r;
+	uint64_t b_dtb = 0, b_main = 0;
+	char slot[4] = "", part[24];
+	if (!ad_mapped || !PE_parse_boot_arg_str("pandora_slot", slot, sizeof(slot))) {
+		printf("PANDORA MODEM: no windows or no slot\n");
+		return;
+	}
+	snprintf(part, sizeof(part), "modemfirmware_%c", slot[0]);
+	uint32_t lun = 0;
+	uint64_t first = 0, blocks = 0;
+	int err = pandora_part_find(part, &lun, &first, &blocks);
+	if (!err) {
+		err = fat_mount(&ad_fat, blocks * 4096, fat_part_read, NULL) ? EFTYPE : 0;
+	}
+	printf("PANDORA MODEM: %s: LUN %u blocks %#llx+%#llx -> %d\n", part, lun, first, blocks, err);
+	if (err) {
+		return;
+	}
+	ad_fat_state = 1;
+	e->t0 = mach_absolute_time();
+	if ((err = p2p_setup(e, "before the start"))) {
+		return;
+	}
+	(void)mss_assign(0x84a00000ull, 0x5500000ull);
+	(void)mss_assign(0x89f00000ull, 0xa80000ull);
+	if ((err = qmp_send("{class: image, res: load_state, name: modem, val: on}"))) {
+		printf("PANDORA MODEM: load_state failed %d\n", err);
+	}
+	(void)arc_vote("cx.lvl", 384);
+	(void)arc_vote("mss.lvl", 384);
+	pas_md_low = MS_LOW_PA;
+	if ((err = pas_load("modem_dtb", true, 0x26, 0x99500000ull, 0x80000ull, &b_dtb)) || (err = pas_auth(0x26))) {
+		printf("PANDORA MODEM: DTB image failed %d\n", err);
+	}
+	if (!(err = pas_load("modem", true, 4, 0x8aa00000ull, 0xeb00000ull, &b_main))) {
+		e->t0 = mach_absolute_time();
+		err = pas_auth(4);
+	}
+	pas_md_low = 0;
+	if (err) {
+		printf("PANDORA MODEM: main image failed %d\n", err);
+		scm_smc(SCM_FN(2, 6), SCM_ARGS(1), 4, 0, 0, 0, &r);
+		scm_smc(SCM_FN(2, 6), SCM_ARGS(1), 0x26, 0, 0, 0, &r);
+		return;
+	}
+	printf("PANDORA MODEM: released from reset\n");
+	for (unsigned ms = 0; ms < 30000; ms += 50) {
+		if (e->slave & (SLAVE_READY | SLAVE_FATAL)) {
+			printf("PANDORA MODEM: slave-kernel %#x after %u ms\n", e->slave, ms);
+			break;
+		}
+		ad_sleep(50);
+	}
+	if (e->slave & SLAVE_FATAL) {
+		printf("PANDORA MODEM: FATAL at start\n");
+		return;
+	}
+	if (!(e->slave & SLAVE_READY)) {
+		printf("PANDORA MODEM: not ready after 30 s, slave-kernel %#x\n", e->slave);
+		return;
+	}
+	err = gl_start(e, false);
+	printf("PANDORA MODEM: GLINK start -> %d\n", err);
+	/* What it does next, with nobody serving its files: the links' reports show its channels. */
+	for (unsigned t = 0; t < 12; t++) {
+		ad_sleep(10000);
+		printf("PANDORA MODEM: at %u s slave-kernel %#x\n", (t + 1) * 10, e->slave);
+		if (e->slave & SLAVE_FATAL) {
+			break;
+		}
+	}
+}
+
+static void
