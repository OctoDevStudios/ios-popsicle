+/*
+ * 0361: the board for Ath12kWifi (Linux ath12k, mac80211, MHI, QRTR; xnu/vendor/nw_all.o, tools/wlan/peach.py). pandora_wlan=2.
+ * PCIe from the steps above; DMA from RAM no DT region claims below 0xb0000000, Android's window (non cached);
+ * firmware from the read-only firmware partition, read once; interrupts polled (nw_wifi_irq_mode 0).
+ */
+#define NW_DMA_PA    0xa7000000ull
+#define NW_DMA_SIZE  0x8000000u
+#define NW_DMA_PAGES (NW_DMA_SIZE >> 12)
+#define NW_FW_PA     0xe1000000ull      /* firmware files: 16 MiB */
+#define NW_FW_SIZE   0x1000000u
+static uint8_t *nw_dma;
+static uint32_t nw_map[NW_DMA_PAGES];   /* first page of a run: its length; others 0xffffffff; free 0 */
+static uint32_t nw_dma_used, nw_dma_peak;
+static uint8_t *nw_fw;
+static struct { const char *name, *path; const uint8_t *data; uint64_t size; } nw_files[] = {
+	{"amss.bin", "peach/amss20.bin", NULL, 0}, {"m3.bin", "peach/phy_ucode20.elf", NULL, 0}, {"aux_ucode.bin", "peach/aux_ucode20.elf", NULL, 0},
+	{"board.bin", "peach/bdwlan.elf", NULL, 0}, {"regdb.bin", "peach/regdb.bin", NULL, 0},
+};
+static vm_offset_t nw_bar;
+static uint32_t nw_pcie_cap;
+static uint32_t nw_shown;
+
+static uint64_t nw_now_ns(void) { uint64_t n; absolutetime_to_nanoseconds(mach_absolute_time(), &n); return n; }
+static uint64_t nw_now_ms(void) { return nw_now_ns() / 1000000; }
+static void nw_sleep_ms(unsigned ms) { wl_sleep(ms ? ms : 1); }
+static void nw_poll(void) { }
+static void nw_log(int level, const char *line)
+{
+	if (nw_shown++ < 2000) {
+		printf("PANDORA NW %d: %s\n", level, line);
+	}
+}
+static void nw_halt(void)
+{
+	printf("PANDORA NW: the driver stopped itself\n");
+	(void)pandora_log_sync();
+	for (;;) {
+		wl_sleep(10000);
+	}
+}
+static void *nw_alloc(size_t n)
+{
+	uint64_t *p = kalloc_data(n + 16, Z_WAITOK);
+	if (p) {
+		p[0] = n + 16;
+		return p + 2;
+	}
+	return NULL;
+}
+static void nw_free(void *v)
+{
+	if (v) {
+		uint64_t *p = (uint64_t *)v - 2;
+		kfree_data(p, p[0]);
+	}
+}
+static void *nw_dma_alloc(size_t n, uint64_t *bus)
+{
+	const uint32_t pages = (uint32_t)((n + 0xfff) >> 12);
+	/* natural alignment for rings, up to 64 KiB */
+	uint32_t align = 1;
+	while (align < pages && align < 16) {
+		align <<= 1;
+	}
+	for (uint32_t i = 0; i + pages <= NW_DMA_PAGES; i += align) {
+		uint32_t k = 0;
+		while (k < pages && !nw_map[i + k]) {
+			k++;
+		}
+		if (k == pages) {
+			nw_map[i] = pages;
+			for (k = 1; k < pages; k++) {
+				nw_map[i + k] = 0xffffffffu;
+			}
+			bzero(nw_dma + ((uint64_t)i << 12), pages << 12);
+			__asm__ volatile ("dsb sy" ::: "memory");
+			nw_dma_used += pages;
+			nw_dma_peak = MAX(nw_dma_peak, nw_dma_used);
+			*bus = NW_DMA_PA + ((uint64_t)i << 12);
+			return nw_dma + ((uint64_t)i << 12);
+		}
+	}
+	printf("PANDORA NW: DMA memory out: %zu bytes wanted, %u of %u pages used\n", n, nw_dma_used, NW_DMA_PAGES);
+	return NULL;
+}
+static void nw_dma_free(size_t n, void *v, uint64_t bus)
+{
+	(void)n;
+	(void)bus;
+	const uint64_t off = (uint64_t)((uint8_t *)v - nw_dma);
+	if (!v || off >= NW_DMA_SIZE) {
+		return;
+	}
+	const uint32_t i = (uint32_t)(off >> 12), pages = nw_map[i];
+	if (!pages || pages == 0xffffffffu) {
+		return;
+	}
+	for (uint32_t k = 0; k < pages; k++) {
+		nw_map[i + k] = 0;
+	}
+	nw_dma_used -= pages;
+}
+static uint64_t nw_dma_map(void *v, size_t n, int dir)
+{
+	(void)dir;
+	const uint64_t off = (uint64_t)((uint8_t *)v - nw_dma);
+	if (off >= NW_DMA_SIZE || off + n > NW_DMA_SIZE) {
+		return 0;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	return NW_DMA_PA + off;
+}
+static void nw_dma_sync(uint64_t bus, size_t n, int dir)
+{
+	(void)bus; (void)n; (void)dir;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+static int nw_fw_get(const char *name, const uint8_t **data, size_t *size)
+{
+	const char *base = name;
+	for (const char *q = name; *q; q++) {
+		if (*q == '/') {
+			base = q + 1;
+		}
+	}
+	for (unsigned i = 0; i < sizeof(nw_files) / sizeof(nw_files[0]); i++) {
+		if (!strcmp(base, nw_files[i].name) && nw_files[i].data) {
+			*data = nw_files[i].data;
+			*size = (size_t)nw_files[i].size;
+			printf("PANDORA NW: firmware %s -> %s, %llu bytes\n", name, nw_files[i].path, nw_files[i].size);
+			return 0;
+		}
+	}
+	printf("PANDORA NW: firmware %s: not provided\n", name);
+	return -1;
+}
+static uint64_t nw_read_cfg_addr(int off)
+{
+	if ((uint32_t)off & 0x80000000u) {
+		return WL_CFG_OFF + nw_pcie_cap + ((uint32_t)off & 0x7fffffffu);
+	}
+	return WL_CFG_OFF + (uint32_t)off;
+}
+static int nw_cfg_read(int off, int size, uint32_t *v)
+{
+	const uint64_t a = nw_read_cfg_addr(off);
+	uint32_t w = rd(dbi, (uint32_t)(a & ~3ull)) >> (8 * (a & 3));
+	*v = size == 4 ? w : size == 2 ? (w & 0xffff) : (w & 0xff);
+	return 0;
+}
+static int nw_cfg_write(int off, int size, uint32_t v)
+{
+	const uint64_t a = nw_read_cfg_addr(off);
+	const uint32_t sh = 8 * (uint32_t)(a & 3), al = (uint32_t)(a & ~3ull);
+	if (size == 4) {
+		wr(dbi, al, v);
+	} else {
+		const uint32_t m = (size == 2 ? 0xffffu : 0xffu) << sh;
+		wr(dbi, al, (rd(dbi, al) & ~m) | ((v << sh) & m));
+	}
+	return 0;
 }
+static int nw_msi_target(uint32_t *lo, uint32_t *hi, uint32_t *data)
+{
+	/* A write nobody reads: the driver polls. In low-bank RAM XNU does not use. */
+	*lo = (uint32_t)(WF_LOW_CTX + 0x38000);
+	*hi = 0;
+	*data = 0;
+	return 0;
+}
+static void *nw_map_phys(uint64_t pa, size_t n)
+{
+	return (void *)ml_io_map_unmappable((vm_offset_t)pa, (n + 0xfff) & ~(size_t)0xfff, VM_WIMG_IO);
+}
+static volatile int nw_scan_done;
+static void nw_ev_scan(void) { nw_scan_done = 1; }
+static void nw_ev_connect(int r) { printf("PANDORA NW: connect result %d\n", r); }
+static void nw_ev_lost(int r) { printf("PANDORA NW: link lost %d\n", r); }
+static const struct lx_platform nw_platform = {
+	.now_ms = nw_now_ms, .sleep_ms = nw_sleep_ms, .poll = nw_poll, .log = nw_log, .halt = nw_halt,
+	.alloc = nw_alloc, .free = nw_free, .dma_alloc = nw_dma_alloc, .dma_free = nw_dma_free, .dma_map = nw_dma_map, .dma_sync = nw_dma_sync,
+	.fw_get = nw_fw_get, .now_ns = nw_now_ns, .boottime_ns = nw_now_ns,
+};
+static struct nw_board nw_the_board;
+static const struct nw_wifi_events nw_events_set = {.scan_done = nw_ev_scan, .connect_done = nw_ev_connect, .link_lost = nw_ev_lost};
 
 static void
+nw_run(void)
+{
+	nw_wifi_set_events(&nw_events_set);
+	nw_wifi_irq_mode(0);
+	int r = nw_wifi_start(&nw_platform, &nw_the_board);
+	printf("PANDORA NW: start -> %d, stage %u, last error %d\n", r, nw_wifi_stats.stage, nw_wifi_stats.last_err);
+	(void)pandora_log_sync();
+	if (r) {
+		return;
+	}
+	uint64_t next = nw_now_ms() + 1000, scan_at = 0;
+	uint32_t was = 0xffffffffu;
+	unsigned scans = 0;
+	for (;;) {
+		const int moved = nw_wifi_step();
+		if (!moved) {
+			const unsigned w = nw_wifi_wait_ms(2);
+			wl_sleep(w ? w : 1);
+		}
+		const uint64_t now = nw_now_ms();
+		struct nw_wifi_status st;
+		nw_wifi_status_get(&st);
+		if (st.state != was) {
+			printf("PANDORA NW: state %u -> %u (result %d); stats stage %u scans %u frames %u beacons %u bss %u; DMA %u pages, peak %u\n", was, st.state, st.result,
+			    nw_wifi_stats.stage, nw_wifi_stats.scans, nw_wifi_stats.frames, nw_wifi_stats.beacons, nw_wifi_stats.bss_seen, nw_dma_used, nw_dma_peak);
+			was = st.state;
+			(void)pandora_log_sync();
+		}
+		if (now >= next) {
+			next = now + 5000;
+			(void)pandora_log_sync();
+			if (!scan_at) {
+				nw_wifi_power(1);
+				scan_at = now + 2000;
+			}
+		}
+		if (scan_at && now >= scan_at && scans < 3) {
+			int sr = nw_wifi_scan(NULL, 0);
+			printf("PANDORA NW: scan asked -> %d\n", sr);
+			scans++;
+			scan_at = now + 15000;
+		}
+		if (nw_scan_done) {
+			nw_scan_done = 0;
+			const int n = nw_wifi_bss_count();
+			printf("PANDORA NW: scan done: %d networks\n", n);
+			for (int i = 0; i < n && i < 30; i++) {
+				static struct nw_bss_info b;
+				if (!nw_wifi_bss_get(i, &b)) {
+					char ssid[33];
+					memcpy(ssid, b.ssid, b.ssid_len);
+					ssid[b.ssid_len] = 0;
+					printf("PANDORA NW: network \"%s\" %u MHz %d dBm\n", ssid, b.freq_mhz, b.signal_dbm);
+				}
+			}
+			(void)pandora_log_sync();
+		}
+	}
+}
