+/* Linux's call depth is not XNU's: its own stack. A sync exception on it panics (fleh_invalid_stack), which at least says so. */
+static void
+nw_on_stack(void)
+{
+	static const size_t size = 1024 * 1024;
+	vm_offset_t st = 0;
+	if (kmem_alloc(kernel_map, &st, size, KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("PANDORA NW: no stack\n");
+		return;
+	}
+	uintptr_t top = (st + size) & ~(uintptr_t)15;
+	__asm__ volatile (
+		"mov x19, sp\n"
+		"mov sp, %0\n"
+		"blr %1\n"
+		"mov sp, x19\n"
+		: : "r"(top), "r"(nw_run)
+		: "x0", "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "x19", "x30", "cc", "memory");
+}
+
+static int
+nw_go(vm_offset_t mhi)
+{
+	int e = pandora_smmu_pass(0x1400, 0x7f);
+	printf("PANDORA NW: SMMU -> %d\n", e);
+	if (e) {
+		return e;
+	}
+	nw_dma = (uint8_t *)ml_io_map_unmappable((vm_offset_t)NW_DMA_PA, NW_DMA_SIZE, VM_WIMG_WCOMB);
+	nw_fw = (uint8_t *)ml_io_map_unmappable((vm_offset_t)NW_FW_PA, NW_FW_SIZE, VM_WIMG_WCOMB);
+	if (!nw_dma || !nw_fw) {
+		return ENOMEM;
+	}
+	uint64_t used = 0;
+	for (unsigned i = 0; i < sizeof(nw_files) / sizeof(nw_files[0]); i++) {
+		uint64_t size = 0;
+		e = pandora_part_file(nw_files[i].path, nw_fw + used, NW_FW_SIZE - used, &size);
+		printf("PANDORA NW: %s -> %d, %llu bytes\n", nw_files[i].path, e, size);
+		if (e) {
+			return e;
+		}
+		nw_files[i].data = nw_fw + used;
+		nw_files[i].size = size;
+		used += (size + 0xfff) & ~0xfffull;
+	}
+	/* the PCIe capability, for offsets with bit 31 */
+	for (uint32_t cap = rd(dbi, WL_CFG_OFF + 0x34) & 0xff, n = 0; cap && n < 32; n++) {
+		const uint32_t h = rd(dbi, WL_CFG_OFF + cap);
+		if ((h & 0xff) == 0x10) {
+			nw_pcie_cap = cap;
+		}
+		if ((h & 0xff) == 5) {
+			nw_the_board.msi_cap = (uint16_t)cap;
+		}
+		cap = (h >> 8) & 0xff;
+	}
+	nw_bar = mhi;
+	nw_the_board.bar = (void *)mhi;
+	nw_the_board.bar_len = 0x200000;
+	nw_the_board.device_id = 0x110e;
+	nw_the_board.irq_base = 16;
+	nw_the_board.cfg_read = nw_cfg_read;
+	nw_the_board.cfg_write = nw_cfg_write;
+	nw_the_board.msi_target = nw_msi_target;
+	nw_the_board.map_phys = nw_map_phys;
+	set(dbi, WL_CFG_OFF + 0x04, 6u);        /* memory, bus master */
+	printf("PANDORA NW: PCIe capability %#x MSI %#x; starting the driver\n", nw_pcie_cap, nw_the_board.msi_cap);
+	(void)pandora_log_sync();
+	nw_on_stack();
+	return 0;
+}
