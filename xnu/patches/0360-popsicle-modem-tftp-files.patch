 static int
+tf_cached(const char *path, const char *name)
+{
+	for (int i = 0; i < 8; i++) {
+		if (tf_cache[i].mem && !strcmp(tf_cache[i].name, name)) {
+			return i;
+		}
+	}
+	struct fw_file ff;
+	int e = fw_open(path, true, &ff);
+	if (e) {
+		printf("PANDORA MODEM: TFTP: %s: open -> %d\n", path, e);
+		return -1;
+	}
+	if (!tf_cache_map && !(tf_cache_map = (uint8_t *)ad_map(TF_CACHE_PA, TF_CACHE_SZ, VM_WIMG_WCOMB))) {
+		return -1;
+	}
+	if (tf_cache_used + ff.size > TF_CACHE_SZ) {
+		printf("PANDORA MODEM: TFTP: %s: %llu bytes do not fit\n", path, ff.size);
+		return -1;
+	}
+	for (int i = 0; i < 8; i++) {
+		if (!tf_cache[i].mem) {
+			uint8_t *m = tf_cache_map + tf_cache_used;
+			const uint64_t t0 = mach_absolute_time();
+			e = fw_pread(&ff, 0, m, ff.size);
+			uint64_t ns;
+			absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+			printf("PANDORA MODEM: TFTP: %s: %llu bytes read in %llu ms -> %d\n", path, ff.size, ns / 1000000, e);
+			if (e) {
+				return -1;
+			}
+			tf_cache[i].mem = m;
+			tf_cache[i].size = ff.size;
+			strlcpy(tf_cache[i].name, name, sizeof(tf_cache[i].name));
+			tf_cache_used += (ff.size + 0xfff) & ~0xfffull;
+			return i;
+		}
+	}
+	return -1;
+}
