+/* A file of /image in the firmware partition (Android's /vendor/firmware_mnt), read only. */
+int
+pandora_part_file(const char *name, void *dst, uint64_t max, uint64_t *size)
+{
+	struct fw_file f;
+	int err = fw_mount();
+	err = err ? err : fw_open(name, true, &f);
+	if (err) {
+		return err;
+	}
+	*size = f.size;
+	return f.size > max ? E2BIG : fw_pread(&f, 0, dst, f.size);
+}
+
+/* Pass a device's streams through the apps SMMU the way the audio streams pass: same S2CR, a free group. */
+int
+pandora_smmu_pass(uint16_t id, uint16_t mask)
+{
+	vm_offset_t s = ad_map(0x15000000u, 0x100000u, VM_WIMG_IO);
+	if (!s) {
+		return ENOMEM;
+	}
+#define SR(o) (*(volatile uint32_t *)(s + (o)))
+	const unsigned nsmr = SR(0x20) & 0xff;      /* SMMU_IDR0.NUMSMRG */
+	uint32_t s2cr = 0;
+	unsigned slot = nsmr;
+	bool have = false;
+	int err = 0;
+	for (unsigned i = 0; i + 1 < nsmr; i++) {
+		const uint32_t smr = SR(0x800 + 4 * i);
+		if (!(smr & 0x80000000u)) {
+			if (slot == nsmr) {
+				slot = i;
+			}
+			continue;
 		}
+		const uint32_t sid = smr & 0x7fff, smask = (smr >> 16) & 0x7fff;
+		if (sid == 0x1001 || sid == 0x1041) {
+			s2cr = SR(0xc00 + 4 * i);
+			have = true;
+		}
+		if (((sid ^ id) & ~(smask | mask) & 0x7fff) == 0) {
+			printf("PANDORA SMMU: group %u (id %#x mask %#x) overlaps streams %#x/%#x: not written\n", i, sid, smask, id, mask);
+			err = EEXIST;
+		}
 	}
+	if (!err && (!have || slot == nsmr)) {
+		printf("PANDORA SMMU: streams %#x: no audio group to copy (%d) or no free group\n", id, have);
+		err = ENOENT;
+	}
+	if (!err) {
+		SR(0xc00 + 4 * slot) = s2cr;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		SR(0x800 + 4 * slot) = 0x80000000u | (uint32_t)mask << 16 | id;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		printf("PANDORA SMMU: group %u for streams %#x mask %#x: SMR %08x S2CR %08x\n", slot, id, mask,
+		    SR(0x800 + 4 * slot), SR(0xc00 + 4 * slot));
+	}
+#undef SR
+	ml_io_unmap(s, 0x100000u);
+	return err;
 }
 
