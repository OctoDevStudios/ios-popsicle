+/* 0355: the second bootloader's own log: BHI ERRDBG2 start, ERRDBG3 size, in the chip's RAM (cnss_pci_dump_bl_sram_mem). */
+static void
+wf_sbl_log(vm_offset_t bar, uint32_t bhi)
+{
+	const uint32_t start = rd(bar, bhi + 0x38);
+	uint32_t size = rd(bar, bhi + 0x3c);
+	static char b[0x1001];
+	printf("PANDORA WLAN: SBL log at %#x, %u bytes\n", start, size);
+	if (start < 0x01400000u || start >= 0x01868000u || !size) {
+		return;
+	}
+	size = MIN(size, 0x1000u);
+	for (uint32_t i = 0; i < size; i += 4) {
+		const uint32_t v = wf_reg(bar, start + i);
+		memcpy(b + i, &v, 4);
+	}
+	b[size] = 0;
+	uint32_t o = 0;
+	while (o < size) {
+		uint32_t e = o;
+		while (e < size && b[e] != '\n' && b[e] != 0 && e - o < 160) {
+			e++;
+		}
+		if (e > o) {
+			const char c = b[e];
+			b[e] = 0;
+			bool text = true;
+			for (uint32_t k = o; k < e; k++) {
+				if ((unsigned char)b[k] < 0x20 && b[k] != '\r' && b[k] != '\t') {
+					text = false;
+				}
+			}
+			printf("PANDORA WLAN: SBL: %s\n", text ? b + o : "(binary)");
+			b[e] = c;
+		}
+		o = e + 1;
+	}
+	(void)pandora_log_sync();
 }
 
