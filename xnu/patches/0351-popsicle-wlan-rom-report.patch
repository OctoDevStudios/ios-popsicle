+}
+
+/* 0351: cnss_pci_dump_bl_sram_mem, peach: what the chip's boot ROM says, through the register window (reg.h). */
+static uint32_t
+wf_reg(vm_offset_t bar, uint32_t off)
+{
+	if (off < 0x80000u) {
+		return rd(bar, off);
+	}
+	wr(bar, 0x3278, 0x40000000u | ((off >> 19) & 0x3fu));
+	(void)rd(bar, 0x3278);
+	return rd(bar, 0x80000u + (off & 0x7ffffu));
+}
+
+static void
+wf_rom_report(vm_offset_t bar, uint32_t bhi)
+{
+	printf("PANDORA WLAN: ROM: hardware version %#x, stage %#x, boot config %#x, bootstrap %#x, BHI error regs %#x %#x %#x %#x, antirollback %#x\n",
+	    rd(bar, 0x224), wf_reg(bar, 0x01b000f8), wf_reg(bar, 0x01e22b34), wf_reg(bar, 0x01a10008),
+	    rd(bar, bhi + 0x30), rd(bar, bhi + 0x34), rd(bar, bhi + 0x38), rd(bar, bhi + 0x3c), rd(bar, bhi + 0x44));
+	for (uint32_t i = 0; i < 40; i += 4) {
+		printf("PANDORA WLAN: ROM log[%u] = %#x\n", i, wf_reg(bar, 0x01403640u + i));
+	}
+	printf("PANDORA WLAN: chip id %#x %#x %#x %#x %#x %#x, key hash %#x %#x %#x %#x\n", rd(bar, bhi + 0x4c), rd(bar, bhi + 0x50),
+	    rd(bar, bhi + 0x54), rd(bar, bhi + 0x58), rd(bar, bhi + 0x5c), rd(bar, bhi + 0x60), rd(bar, bhi + 0x64), rd(bar, bhi + 0x68),
+	    rd(bar, bhi + 0x6c), rd(bar, bhi + 0x70));
+	(void)pandora_log_sync();
 }
 
