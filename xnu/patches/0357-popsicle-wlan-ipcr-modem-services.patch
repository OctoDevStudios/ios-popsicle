+/* A raw packet back to whoever asked (TFTP is not QMI). */
+static void
+ms_raw_reply(const uint8_t *req, const uint8_t *p, uint32_t n)
+{
+	if ((ms_out_w - ms_out_r) >= MS_RING) {
