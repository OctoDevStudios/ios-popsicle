+
+/*
+ * 0357: mission mode: the IPCR channels (cnss_mhi_channels 20 up, 21 down, event ring 1, 64 elements) and QRTR over them,
+ * as net/qrtr/mhi.c with polling: start commands, buffers down, HELLO up, and who the chip announces (WLFW is service 69).
+ * main.c: mhi_prepare_channel; common.h for the TRE and event words.
+ */
+#define WF_UL   20u
+#define WF_DL   21u
+#define WF_TRES 64u
+static void
+wf_chan(vm_offset_t ctx, uint64_t ctx_pa, unsigned ch, unsigned dir, uint32_t ring_off)
+{
+	volatile uint32_t *c = (volatile uint32_t *)(ctx + 44u * ch);
+	const uint64_t b = ctx_pa + ring_off;
+	c[0] = 1u | (2u << 8);                  /* enabled, burst off */
+	c[1] = dir;                             /* 1 to the device, 2 from it */
+	c[2] = 1;                               /* event ring */
+	c[3] = (uint32_t)b; c[4] = (uint32_t)(b >> 32);
+	c[5] = WF_TRES * 16u; c[6] = 0;
+	c[7] = (uint32_t)b; c[8] = (uint32_t)(b >> 32);
+	c[9] = (uint32_t)b; c[10] = (uint32_t)(b >> 32);
 }
 
+static void
+wf_ipcr(vm_offset_t mhi, uint32_t bhi, vm_offset_t ctx, uint64_t ctx_pa)
+{
+	const uint32_t chdb = rd(mhi, 0x18), erdb = rd(mhi, 0x20);
+	const uint32_t ul_off = 0x24000, dl_off = 0x25000, buf_off = 0x40000, tx_off = 0x60000;
+	wf_chan(ctx, ctx_pa, WF_UL, 1, ul_off);
+	wf_chan(ctx, ctx_pa, WF_DL, 2, dl_off);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	/* start commands */
+	volatile uint32_t *cmd = (volatile uint32_t *)(ctx + 0x20000);
+	const unsigned chans[2] = {WF_UL, WF_DL};
+	for (unsigned i = 0; i < 2; i++) {
+		cmd[4 * i] = 0; cmd[4 * i + 1] = 0; cmd[4 * i + 2] = 0;
+		cmd[4 * i + 3] = (chans[i] << 24) | (18u << 16);        /* MHI_CMD_START_CHAN */
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	const uint64_t cwp = ctx_pa + 0x20000 + 32;
+	volatile uint32_t *cc = (volatile uint32_t *)(ctx + 0x3000);
+	cc[9] = (uint32_t)cwp; cc[10] = (uint32_t)(cwp >> 32);
+	wr(mhi, 0x74, (uint32_t)(cwp >> 32));
+	wr(mhi, 0x70, (uint32_t)cwp);
+	wl_sleep(100);
+	const volatile uint32_t *c0 = (const volatile uint32_t *)(ctx + 0x2000);
+	const volatile uint32_t *ev0 = (const volatile uint32_t *)(ctx + 0x10000);
+	printf("PANDORA WLAN: IPCR start: control ring rp %08x; events", c0[7]);
+	for (unsigned i = 0; i < 6; i++) {
+		printf(" %08x:%08x", ev0[4 * i + 2], ev0[4 * i + 3]);
+	}
+	printf("; states %#x %#x\n", ((const volatile uint32_t *)(ctx + 44u * WF_UL))[0], ((const volatile uint32_t *)(ctx + 44u * WF_DL))[0]);
+	/* buffers for the chip */
+	volatile uint32_t *dl = (volatile uint32_t *)(ctx + dl_off);
+	for (unsigned i = 0; i < 16; i++) {
+		const uint64_t b = ctx_pa + buf_off + 4096ull * i;
+		dl[4 * i] = (uint32_t)b; dl[4 * i + 1] = (uint32_t)(b >> 32);
+		dl[4 * i + 2] = 4096;
+		dl[4 * i + 3] = (2u << 16) | (1u << 9);                 /* transfer, event at the end */
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	uint64_t dwp = ctx_pa + dl_off + 16 * 16;
+	wr(mhi, chdb + 8 * WF_DL + 4, (uint32_t)(dwp >> 32));
+	wr(mhi, chdb + 8 * WF_DL, (uint32_t)dwp);
+	/* HELLO, as qrtr_send_hello: node 1 */
+	static const uint32_t hello[13] = {1, 2, 1, 0xfffffffeu, 0, 20, 0xffffffffu, 0xfffffffeu, 2, 0, 0, 0, 0};
+	memcpy((void *)(ctx + tx_off), hello, sizeof(hello));
+	volatile uint32_t *ul = (volatile uint32_t *)(ctx + ul_off);
+	const uint64_t tb = ctx_pa + tx_off;
+	ul[0] = (uint32_t)tb; ul[1] = (uint32_t)(tb >> 32); ul[2] = 52; ul[3] = (2u << 16) | (1u << 9);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	const uint64_t uwp = ctx_pa + ul_off + 16;
+	wr(mhi, chdb + 8 * WF_UL + 4, (uint32_t)(uwp >> 32));
+	wr(mhi, chdb + 8 * WF_UL, (uint32_t)uwp);
+	printf("PANDORA WLAN: IPCR: buffers given, HELLO sent\n");
+	(void)pandora_log_sync();
+	/* events of ring 1: which buffers came back */
+	const uint64_t er1 = ctx_pa + 0x10000 + 0x2000;
+	const volatile uint32_t *ev = (const volatile uint32_t *)(ctx + 0x12000);
+	const volatile uint32_t *c1 = (const volatile uint32_t *)(ctx + 0x2000 + 44u);
+	uint64_t rp = er1;
+	unsigned shown = 0;
+	for (unsigned t = 0; t < 2000; t++) {
+		const uint64_t dev = c1[7] | ((uint64_t)c1[8] << 32);
+		while (rp != dev && dev >= er1 && dev < er1 + WF_ELS * 16u) {
+			const unsigned i = (unsigned)((rp - er1) / 16);
+			const uint32_t lo = ev[4 * i], d0 = ev[4 * i + 2], d1 = ev[4 * i + 3];
+			const unsigned ch = d1 >> 24, type = (d1 >> 16) & 0xff, len = d0 & 0xffff;
+			if (ch == WF_DL && type == 0x22) {
+				const uint64_t tre = lo | ((uint64_t)ev[4 * i + 1] << 32);
+				const unsigned n = (unsigned)((tre - (ctx_pa + dl_off)) / 16);
+				if (n < 16) {
+					const volatile uint32_t *q = (const volatile uint32_t *)(ctx + buf_off + 4096u * n);
+					if (shown++ < 80) {
+						printf("PANDORA WLAN: QRTR from chip: %u bytes, type %u from %u:%u to %u:%u; words %u %u %u %u %u\n", len, q[1], q[2], q[3], q[6], q[7], q[8], q[9], q[10], q[11], q[12]);
+					}
+					/* the same buffer back in the ring's next place */
+					const unsigned w = (unsigned)((dwp - (ctx_pa + dl_off)) / 16);
+					const uint64_t b = ctx_pa + buf_off + 4096ull * n;
+					dl[4 * w] = (uint32_t)b; dl[4 * w + 1] = (uint32_t)(b >> 32);
+					dl[4 * w + 2] = 4096;
+					dl[4 * w + 3] = (2u << 16) | (1u << 9);
+					__asm__ volatile ("dsb sy" ::: "memory");
+					dwp = ctx_pa + dl_off + 16ull * ((w + 1) % WF_TRES);
+					wr(mhi, chdb + 8 * WF_DL + 4, (uint32_t)(dwp >> 32));
+					wr(mhi, chdb + 8 * WF_DL, (uint32_t)dwp);
+				}
+			} else if (shown++ < 80) {
+				printf("PANDORA WLAN: event: channel %u type %#x length %u code %u\n", ch, type, len, d0 >> 24);
+			}
+			wr(mhi, erdb + 8 + 4, (uint32_t)(rp >> 32));
+			wr(mhi, erdb + 8, (uint32_t)rp);        /* this element free again */
+			rp = er1 + ((rp - er1 + 16) % (WF_ELS * 16u));
+		}
+		if (rd(mhi, 0x48) & 4u) {
+			printf("PANDORA WLAN: SYSERR in mission mode, EE %#x\n", rd(mhi, bhi + 0x28));
+			wf_sbl_log(mhi, bhi);
+			return;
+		}
+		wl_sleep(10);
+	}
+	printf("PANDORA WLAN: IPCR: %u things seen in 20 s; EE %#x status %#x\n", shown, rd(mhi, bhi + 0x28), rd(mhi, 0x48));
+	(void)pandora_log_sync();
+}
