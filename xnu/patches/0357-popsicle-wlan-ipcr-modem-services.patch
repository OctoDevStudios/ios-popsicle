+			memcpy(a + 7, none, sizeof(none));
+			al += sizeof(none);
+		} else {
+			a[3] = 1;
+			a[5] = 1;
+		}
+		if (m[32] == 0) {
+			rfs_reply(m, mid, a, al);
+		}
+		return;
+	}
 	if (len < 39 || m[32] != 0) {
 		return;
 	}
