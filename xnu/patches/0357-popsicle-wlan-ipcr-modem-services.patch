+	memcpy(hdr, req, 32);
+	uint8_t *o = ms_out[ms_out_w % MS_RING].d;
+	const uint32_t out[8] = {1, 1, 1, hdr[7], 0, n, hdr[2], hdr[3]};
+	memcpy(o, out, 32);
+	memcpy(o + 32, p, n);
+	ms_out[ms_out_w % MS_RING].len = 32 + ((n + 3) & ~3u);
+	__atomic_fetch_add(&ms_out_w, 1, __ATOMIC_RELEASE);
 }
 
