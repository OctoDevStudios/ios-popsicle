+/* 0354: the chip's MSI on, as Android has it: pci_alloc_irq_vectors + the MSI capability; the write lands in our RAM. */
+static void
+wf_msi(void)
+{
+	uint32_t cap = rd(dbi, WL_CFG_OFF + 0x34) & 0xff;
+	for (unsigned i = 0; cap && i < 32; i++) {
+		const uint32_t h = rd(dbi, WL_CFG_OFF + cap);
+		if ((h & 0xff) == 5) {
+			const bool is64 = (h & (1u << 23)) != 0;
+			const uint64_t a = WF_LOW_CTX + 0x38000;
+			wr(dbi, WL_CFG_OFF + cap + 4, (uint32_t)a);
+			if (is64) {
+				wr(dbi, WL_CFG_OFF + cap + 8, (uint32_t)(a >> 32));
+			}
+			wr(dbi, WL_CFG_OFF + cap + (is64 ? 12 : 8), 0);
+			wr(dbi, WL_CFG_OFF + cap, h | (1u << 16));
+			printf("PANDORA WLAN: MSI at %#x: was %#x, now %#x, 64 bit %d, address %#llx\n", cap, h, rd(dbi, WL_CFG_OFF + cap), is64, a);
+			return;
+		}
+		cap = (h >> 8) & 0xff;
+	}
+	printf("PANDORA WLAN: no MSI capability\n");
+}
+
+/* 0354: the same chip, off and on, link again: tries of one boot instead of one test each. */
+static int
+wf_again(unsigned variant)
+{
+	clr(parf, 0x1b0, 1u << 8);
+	wl_gpio(GPIO_PERST, 0x200u | 1u, 0);
+	wl_gpio(GPIO_WLAN_EN, 0x200u | (7u << 6) | 3u, 0);
+	wl_sleep(200);
+	switch (variant) {
+	case 1:
+		printf("PANDORA WLAN: try 1: host SOL line left alone\n");
+		wl_gpio(GPIO_HOST_SOL, 0, -1);
+		break;
+	case 2:
+		wl_gpio(GPIO_HOST_SOL, 0x200u, 0);
+		printf("PANDORA WLAN: try 2: no rf_clk vote -> %d (Android: no need enable clk)\n", pandora_rpmh_clk_set("C1A_E0", 0));
+		break;
+	case 3:
+		printf("PANDORA WLAN: try 3: link at Gen1; rf_clk back -> %d\n", pandora_rpmh_clk_set("C1A_E0", 1));
+		wr(dbi, 0x70 + 0x30, (rd(dbi, 0x70 + 0x30) & ~0xfu) | 1u);
+		break;
+	default:
+		break;
+	}
+	wl_gpio(GPIO_WLAN_EN, 0x200u | (7u << 6) | 3u, 1);
+	wl_sleep(100);
+	wl_gpio(GPIO_PERST, 0x200u | 1u, 1);
+	wl_sleep(10);
+	(void)pandora_log_sync();
+	set(parf, 0x1b0, 1u << 8);
+	uint32_t st = 0, lnk = 0;
+	bool up = false;
+	for (unsigned i = 0; i < 1000 && !up; i++) {
+		st = rd(dbi, WL_ELBI_OFF + 8);
+		lnk = rd(dbi, 0x70 + 0x10);
+		up = (st & 0x400u) && (lnk & (1u << 29));
+		if (!up) {
+			wl_sleep(1);
+		}
+	}
+	printf("PANDORA WLAN: try %u: link %d status %#x link register %#x\n", variant, up, st, lnk);
+	if (!up) {
+		return ETIMEDOUT;
+	}
+	wl_sleep(100);
+	const uint32_t id = rd(dbi, WL_CFG_OFF);
+	if (id != WLAN_ID) {
+		printf("PANDORA WLAN: try %u: id %#x\n", variant, id);
+		return EIO;
+	}
+	wr(dbi, WL_CFG_OFF + 0x10, 0x40400000u);
+	wr(dbi, WL_CFG_OFF + 0x14, 0);
+	set(dbi, WL_CFG_OFF + 0x04, 6u);
+	delay(100);
+	return 0;
 }
 
