+/*
+ * 0358: tqftpserv in small: /readonly/firmware from the read-only firmware partition already mounted, /readwrite in RAM
+ * only (gone at the next boot), nothing else. wsize 1 and a block size that fits one message, whatever is asked.
+ */
+#define TF_BLK_MAX   3584u
+#define TF_STORE_PA  0xe5000000ull      /* 16 files of 1 MiB */
+#define TF_STORE_SZ  0x100000u
+static struct {
+	char name[72];
+	uint8_t *mem;
+	uint32_t size;
+	bool used;
+} tf_store[16];
+static struct {
+	uint32_t port;
+	bool active, write, fat;
+	int file;
+	struct fw_file ff;
+	uint64_t size, seek, rsize;
+	uint32_t blk;
+	uint16_t expected;
+} tf_c[16];
+static uint32_t tf_shown;
+
+static int
+tf_find(const char *name, bool make)
+{
+	for (int i = 0; i < 16; i++) {
+		if (tf_store[i].used && !strcmp(tf_store[i].name, name)) {
+			return i;
+		}
+	}
+	if (!make) {
+		return -1;
+	}
+	for (int i = 0; i < 16; i++) {
+		if (!tf_store[i].used) {
+			tf_store[i].mem = (uint8_t *)ad_map(TF_STORE_PA + (uint64_t)i * TF_STORE_SZ, TF_STORE_SZ, VM_WIMG_WCOMB);
+			if (!tf_store[i].mem) {
+				return -1;
+			}
+			strlcpy(tf_store[i].name, name, sizeof(tf_store[i].name));
+			tf_store[i].size = 0;
+			tf_store[i].used = true;
+			return i;
+		}
+	}
+	return -1;
+}
+
+static void
+tf_error(const uint8_t *req, uint8_t code, const char *msg)
+{
+	uint8_t e[64] = {0, 5, 0, code};
+	strlcpy((char *)e + 4, msg, 58);
+	ms_raw_reply(req, e, 4 + (uint32_t)strlen(msg) + 1);
+}
+
+/* The block after `last`, or nothing when the file has ended. */
+static void
+tf_send_block(const uint8_t *req, int c, uint32_t last)
+{
+	static uint8_t b[TF_BLK_MAX + 4];
+	const uint64_t off = tf_c[c].seek + (uint64_t)last * tf_c[c].blk;
+	uint64_t n = off < tf_c[c].size ? MIN((uint64_t)tf_c[c].blk, tf_c[c].size - off) : 0;
+	if (tf_c[c].rsize && (uint64_t)(last + 1) * tf_c[c].blk > tf_c[c].rsize) {
+		n = MIN(n, tf_c[c].rsize % tf_c[c].blk);
+	}
+	b[0] = 0;
+	b[1] = 3;
+	b[2] = (uint8_t)((last + 1) >> 8);
+	b[3] = (uint8_t)(last + 1);
+	if (n) {
+		if (tf_c[c].fat) {
+			if (fw_pread(&tf_c[c].ff, off, b + 4, n)) {
+				tf_error(req, 0, "read error");
+				tf_c[c].active = false;
+				return;
+			}
+		} else {
+			memcpy(b + 4, tf_store[tf_c[c].file].mem + off, (size_t)n);
+		}
+	}
+	ms_raw_reply(req, b, 4 + (uint32_t)n);
+	if (n < tf_c[c].blk) {
+		tf_c[c].active = false;
+	}
+}
