+			else if (!strcmp(k, "timeoutms")) { timeout = val; want_timeout = true; }
+			else if (!strcmp(k, "rsize")) { rsize = val; want_rsize = true; }
+			else if (!strcmp(k, "seek")) { seek = val; want_seek = true; }
+		}
