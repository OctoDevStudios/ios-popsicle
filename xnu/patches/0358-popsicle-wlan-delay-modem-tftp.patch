+		}
+		static char oack[256];
+		uint32_t ol = 2;
+		oack[0] = 0;
+		oack[1] = 6;
+#define TF_OPT(key, val) do { ol += (uint32_t)strlcpy(oack + ol, key, sizeof(oack) - ol) + 1; ol += (uint32_t)snprintf(oack + ol, sizeof(oack) - ol, "%llu", (unsigned long long)(val)) + 1; } while (0)
+		if (want_blkopt) { TF_OPT("blksize", tf_c[c].blk); }
+		if (want_timeout) { TF_OPT("timeoutms", timeout); }
+		if (want_tsize) { TF_OPT("tsize", tf_c[c].size); }
+		if (want_wsize) { TF_OPT("wsize", 1); }
+		if (want_rsize) { TF_OPT("rsize", rsize); }
+		if (want_seek) { TF_OPT("seek", seek); }
+#undef TF_OPT
+		ms_raw_reply(m, (const uint8_t *)oack, ol);
+		return;
+	}
+	if (c < 0) {
