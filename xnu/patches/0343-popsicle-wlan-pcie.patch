 }
 
+LCK_GRP_DECLARE(ad_rpmh_grp, "pandora_rpmh");
+LCK_MTX_DECLARE(ad_rpmh_lock, &ad_rpmh_grp);
+
 static int
-rpmh_write1(uint32_t addr, uint32_t data)
+rpmh_write1_locked(uint32_t addr, uint32_t data)
 {
 	const uint32_t tcs = 0xd00, stride = 0x2a0;
 	int chosen = -1;
@@ -400,6 +403,39 @@
 	ad_wr(ad_rsc, tcs + 8, bit);
 	ad_wr(ad_rsc, tcs + 0, irq_en);
 	return done ? 0 : ETIMEDOUT;
+}
+
+static int
+rpmh_write1(uint32_t addr, uint32_t data)
+{
+	lck_mtx_lock(&ad_rpmh_lock);
+	int e = rpmh_write1_locked(addr, data);
+	lck_mtx_unlock(&ad_rpmh_lock);
+	return e;
+}
+
+/* One VRM (rpmh-regulator order: voltage, mode, enable) for bsd/dev/pandora_wlan.c. mode < 0 leaves it alone. */
+int pandora_rpmh_vrm(const char *res, uint32_t mv, int mode);
+
+int
+pandora_rpmh_vrm(const char *res, uint32_t mv, int mode)
+{
+	uint32_t addr, aux, len;
+	if (!ad_rsc) {
+		ad_rsc = ad_map(AD_RSC_PA, 0x10000, VM_WIMG_IO);
+	}
+	if (!ad_db) {
+		ad_db = ad_map(AD_CMDDB_PA, AD_CMDDB_SIZE, VM_WIMG_IO);
+	}
+	int e = cmddb_find(res, &addr, &aux, &len);
+	if (e) {
+		return e;
+	}
+	e = rpmh_write1(addr, mv);
+	if (!e && mode >= 0) {
+		e = rpmh_write1(addr + 8, (uint32_t)mode);
+	}
+	return e ? e : rpmh_write1(addr + 4, 1);
 }
 
