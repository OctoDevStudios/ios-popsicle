+static void
+ms_worker(void *arg, wait_result_t w)
+{
+	(void)arg;
+	(void)w;
+	static uint8_t m[MS_MSG_MAX];
+	for (;;) {
+		if (__atomic_load_n(&ms_in_w, __ATOMIC_ACQUIRE) == ms_in_r) {
+			ad_sleep(2);
+			continue;
+		}
+		const uint32_t len = ms_in[ms_in_r % MS_RING].len;
+		memcpy(m, ms_in[ms_in_r % MS_RING].d, len);
+		__atomic_fetch_add(&ms_in_r, 1, __ATOMIC_RELEASE);
+		rfs_handle(m, len);
+	}
+}
+
+static void
+ms_rfs_prepare(void)
+{
+	thread_t thread;
+	int e = mss_assign(RFS_BUF_PA, RFS_BUF_SIZE, true);
+	rfs_buf = (uint8_t *)ad_map(RFS_BUF_PA, RFS_BUF_SIZE, VM_WIMG_WCOMB);
+	if (rfs_buf) {
+		bzero(rfs_buf, RFS_BUF_SIZE);
+	}
+	printf("PANDORA MODEM: file service buffer %#llx: assign %d, mapped %d\n", RFS_BUF_PA, e, rfs_buf != NULL);
+	if (kernel_thread_start(ms_worker, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+/* The links' thread: replies ready, sent here. */
+static void
+ms_tx_step(void)
+{
+	while (ms_ch && __atomic_load_n(&ms_out_w, __ATOMIC_ACQUIRE) != ms_out_r) {
+		if (qcom_glink_send(&ed_modem.gl, ms_ch, ms_out[ms_out_r % MS_RING].d, ms_out[ms_out_r % MS_RING].len) != QcomGlinkOk) {
+			return;
+		}
+		__atomic_fetch_add(&ms_out_r, 1, __ATOMIC_RELEASE);
+	}
+}
