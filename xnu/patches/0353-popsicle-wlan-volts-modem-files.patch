+#define RFS_BUF_SIZE  0x400000u
+#define RFS_FILE_PA   0xe3000000ull     /* 8 MiB per file */
+#define RFS_FILE_SIZE 0x800000u
+#define RFS_PORT      0x4000u
+#define MS_MSG_MAX    4096u
+#define MS_RING       8u
