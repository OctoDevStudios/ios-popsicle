+static void
+ms_ctrl_send(QcomGlinkChannel *ch, uint32_t node, uint32_t port, const uint32_t *words, unsigned n)
+{
+	uint32_t pkt[8 + 8] = {1, 2, 1, 0xfffffffeu, 0, 20, node, port};
+	pkt[1] = words[0] == 7 ? 7 : words[0];
+	for (unsigned i = 0; i < n && i < 5; i++) {
+		pkt[8 + i] = words[i];
+	}
+	int e = qcom_glink_send(&ed_modem.gl, ch, pkt, 52);
+	if (e) {
+		printf("PANDORA MODEM: control %u not sent: %d\n", words[0], e);
+	}
+}
+
+static void
+rfs_reply(const uint8_t *req, uint16_t msg, const uint8_t *tlv, uint32_t tlv_len)
+{
+	if ((ms_out_w - ms_out_r) >= MS_RING) {
+		printf("PANDORA MODEM: file service reply lost\n");
+		return;
+	}
+	uint8_t *o = ms_out[ms_out_w % MS_RING].d;
+	uint32_t hdr[8];
+	memcpy(hdr, req, 32);
+	const uint32_t size = 7 + tlv_len;
+	const uint32_t out[8] = {1, 1, 1, RFS_PORT, 0, size, hdr[2], hdr[3]};
+	memcpy(o, out, 32);
+	o[32] = 2;                              /* QMI response */
+	o[33] = req[33];
+	o[34] = req[34];                        /* the transaction */
+	o[35] = (uint8_t)msg;
+	o[36] = (uint8_t)(msg >> 8);
+	o[37] = (uint8_t)tlv_len;
+	o[38] = (uint8_t)(tlv_len >> 8);
+	memcpy(o + 39, tlv, tlv_len);
+	ms_out[ms_out_w % MS_RING].len = 32 + ((size + 3) & ~3u);
+	__atomic_fetch_add(&ms_out_w, 1, __ATOMIC_RELEASE);
+}
+
+/* TLV type t of a QMI message, its length through *len. */
+static const uint8_t *
+rfs_tlv(const uint8_t *p, uint32_t n, uint8_t t, uint32_t *len)
+{
+	for (uint32_t o = 0; o + 3 <= n;) {
+		const uint32_t l = p[o + 1] | (uint32_t)p[o + 2] << 8;
+		if (o + 3 + l > n) {
+			return NULL;
+		}
+		if (p[o] == t) {
+			*len = l;
+			return p + o + 3;
+		}
+		o += 3 + l;
+	}
+	return NULL;
+}
 
 static void
+rfs_handle(const uint8_t *m, uint32_t len)
+{
+	if (len < 39 || m[32] != 0) {
+		return;
+	}
+	const uint16_t id = m[35] | (uint16_t)m[36] << 8;
+	const uint8_t *body = m + 39;
+	const uint32_t blen = MIN((uint32_t)(m[37] | m[38] << 8), len - 39);
+	uint8_t t[32] = {2, 4, 0, 0, 0, 0, 0};      /* TLV 2: result 0, error 0 */
+	uint32_t l = 0, tl = 7;
+	const uint8_t *v;
+	uint32_t caller = 0xffffffffu;
+	if ((v = rfs_tlv(body, blen, 1, &l)) != NULL && l >= 4 && id != 1) {
+		memcpy(&caller, v, 4);
+	}
+	switch (id) {
+	case 1: {                               /* open */
+		char path[64] = "";
+		if (v) {
+			memcpy(path, v, MIN(l, (uint32_t)sizeof(path) - 1));
+		}
+		int f = -1;
+		for (int i = 0; i < 4; i++) {
+			if (!strcmp(path, rfs_files[i].path)) {
+				f = i;
+			}
+		}
+		int e = f < 0 ? ENOENT : 0;
+		if (f >= 0 && !rfs_f[f].open) {
+			uint32_t lun = 0;
+			uint64_t first = 0, blocks = 0;
+			e = pandora_part_find(rfs_files[f].part, &lun, &first, &blocks);
+			const uint64_t size = MIN(blocks * 4096, (uint64_t)RFS_FILE_SIZE);
+			if (!e) {
+				rfs_f[f].mem = (uint8_t *)ad_map(RFS_FILE_PA + (uint64_t)f * RFS_FILE_SIZE, RFS_FILE_SIZE, VM_WIMG_WCOMB);
+				e = rfs_f[f].mem ? pandora_part_pread(0, rfs_f[f].mem, size) : ENOMEM;
+			}
+			if (!e) {
+				rfs_f[f].size = size;
+				rfs_f[f].open = true;
+			}
+		}
+		printf("PANDORA MODEM: file service: open %s -> %d (%llu bytes, in RAM)\n", path, e, f >= 0 ? rfs_f[f].size : 0);
+		if (e) {
+			t[3] = 1;
+			t[5] = 1;
+		} else {
+			t[7] = 0x10; t[8] = 4; t[9] = 0;
+			const uint32_t c = (uint32_t)f + 1;
+			memcpy(t + 10, &c, 4);
+			tl = 14;
+		}
+		break;
+	}
+	case 2:                                 /* close */
+		printf("PANDORA MODEM: file service: close %u (%u reads, %u writes kept in RAM so far)\n", caller, ms_reads, ms_writes);
+		break;
+	case 3: {                               /* read or write vectors */
+		const int f = (int)caller - 1;
+		uint32_t dl = 0, il = 0;
+		const uint8_t *dir = rfs_tlv(body, blen, 2, &dl), *iv = rfs_tlv(body, blen, 3, &il);
+		bool bad = f < 0 || f > 3 || !rfs_f[f < 0 ? 0 : f].open || !dir || !iv || il < 1 || !rfs_buf;
+		if (!bad) {
+			const uint32_t n = iv[0];
+			for (uint32_t i = 0; i < n && 1 + 12 * (i + 1) <= il; i++) {
+				uint32_t w[3];
+				memcpy(w, iv + 1 + 12 * i, 12);
+				const uint64_t off = (uint64_t)w[0] * 512, sz = (uint64_t)w[2] * 512;
+				if (off + sz > rfs_f[f].size || (uint64_t)w[1] + sz > RFS_BUF_SIZE) {
+					printf("PANDORA MODEM: file service: vector outside: sector %u count %u buffer %#x\n", w[0], w[2], w[1]);
+					bad = true;
+					break;
+				}
+				if (dir[0]) {
+					memcpy(rfs_f[f].mem + off, rfs_buf + w[1], (size_t)sz);       /* RAM only */
+					ms_writes++;
+				} else {
+					memcpy(rfs_buf + w[1], rfs_f[f].mem + off, (size_t)sz);
+					ms_reads++;
+				}
+			}
+			__asm__ volatile ("dsb sy" ::: "memory");
+			if ((ms_reads + ms_writes) % 16 == 1) {
+				printf("PANDORA MODEM: file service: %s on %u; %u reads, %u writes kept in RAM\n", dir[0] ? "write" : "read", caller, ms_reads, ms_writes);
+			}
+		}
+		if (bad) {
+			t[3] = 1;
+			t[5] = 1;
+		}
+		break;
+	}
+	case 4: {                               /* buffer */
+		const uint64_t a = RFS_BUF_PA;
+		t[7] = 0x10; t[8] = 8; t[9] = 0;
+		memcpy(t + 10, &a, 8);
+		tl = 18;
+		printf("PANDORA MODEM: file service: buffer %#llx asked by %u\n", a, caller);
+		break;
+	}
+	case 5:                                 /* device error: none */
+		t[7] = 0x10; t[8] = 1; t[9] = 0; t[10] = 0;
+		tl = 11;
+		break;
+	default:
+		printf("PANDORA MODEM: file service: message %u\n", id);
+		t[3] = 1;
+		t[5] = 2;
+		break;
+	}
+	rfs_reply(m, id, t, tl);
+}
